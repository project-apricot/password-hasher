{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // Both keys are optional. Omitting the section entirely gives PBKDF2-SHA512 at the
  // algorithm's own default iteration count, which is what these values spell out.
  "PasswordHasher": {
    "Algorithm": "PBKDF2-SHA512",
    "Iterations": 210000
  }
}
