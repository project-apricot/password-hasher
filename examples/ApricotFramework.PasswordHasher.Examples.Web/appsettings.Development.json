{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  // Lowered to the permitted floor so the demo endpoints respond quickly. Anything below
  // this is rejected at startup rather than silently producing a weak hash.
  "PasswordHasher": {
    "Iterations": 10000
  }
}
